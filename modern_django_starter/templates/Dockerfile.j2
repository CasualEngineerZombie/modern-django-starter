# Use Python 3.14 slim image
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Pillow 11.0.0 has no cp314 wheels yet, so the Docker build compiles it from
# source on python:3.14-slim and needs the zlib/JPEG development headers.
RUN apt-get update && apt-get install -y \
    build-essential \
    {% if config.use_postgresql %}
    libpq-dev \
    {% endif %}
    curl \
    zlib1g-dev \
    libjpeg62-turbo-dev \
    && rm -rf /var/lib/apt/lists/*

{% if config.frontend_pipeline != 'none' %}
# Install Node.js 24 LTS
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get update \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*
{% endif %}

# Production images install production.txt; the compose dev stack overrides
# REQUIREMENTS to development.txt (see docker-compose.yml build args) because
# it runs the development settings module, which imports dev-only apps such as
# debug_toolbar and django_extensions.
ARG REQUIREMENTS=requirements/production.txt
COPY requirements/ requirements/
RUN pip install --no-cache-dir -r ${REQUIREMENTS}

{% if config.frontend_pipeline != 'none' %}
COPY package.json ./
RUN npm install
{% endif %}

COPY . .

RUN chmod +x entrypoint.sh

{% if config.frontend_pipeline != 'none' %}
RUN npm run build
{% endif %}

# Collect static files under the PRODUCTION settings module: the production
# image only installs requirements/production.txt, and the default
# (development) settings pull in dev-only apps such as debug_toolbar.
RUN DJANGO_SETTINGS_MODULE={{ project_name }}.settings.production \
    python manage.py collectstatic --noinput

RUN adduser --disabled-password --gecos '' appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

CMD ["gunicorn", "--bind", "0.0.0.0:8000", "{{ project_name }}.wsgi:application"]
