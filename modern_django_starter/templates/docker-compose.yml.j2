services:
  web:
    build:
      context: .
      args:
        # The dev stack runs the development settings module, which needs the
        # dev-only apps (debug_toolbar, django-extensions) from development.txt.
        REQUIREMENTS: requirements/development.txt
    ports:
      - "8000:8000"
    entrypoint: ["/bin/sh", "/app/entrypoint.sh"]
    # Run as the host user so files created in the bind mount (db.sqlite3,
    # staticfiles/) stay owned by the developer (defaults to 1000:1000).
    user: "${UID:-1000}:${GID:-1000}"
    volumes:
      - .:/app
      - media_volume:/app/media
    environment:
      - DEBUG=1
      - DJANGO_SETTINGS_MODULE={{ project_name }}.settings.development
      {% if config.use_postgresql %}
      - DB_NAME={{ project_name }}
      - DB_USER=postgres
      - DB_PASSWORD=postgres
      - DB_HOST=db
      - DB_PORT=5432
      {% endif %}
      {% if config.use_celery %}
      - CELERY_BROKER_URL=redis://redis:6379/0
      - CELERY_RESULT_BACKEND=redis://redis:6379/0
      {% endif %}
    {% if config.use_postgresql or config.use_celery %}
    depends_on:
      {% if config.use_postgresql %}
      db:
        condition: service_healthy
      {% endif %}
      {% if config.use_celery %}
      redis:
        condition: service_healthy
      {% endif %}
    {% endif %}
    command: python manage.py runserver 0.0.0.0:8000
    # The app is only "healthy" once the entrypoint initialized it (dependencies
    # reachable, migrations applied, static files collected) and the dev server
    # is serving requests.
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/admin/login/', timeout=5)"]
      interval: 10s
      timeout: 10s
      retries: 6
      start_period: 30s

  {% if config.use_postgresql %}
  db:
    image: postgres:{{ config.postgresql_version }}
    volumes:
      - postgres_data:{{ '/var/lib/postgresql' if config.postgresql_version | int >= 18 else '/var/lib/postgresql/data/' }}
    environment:
      POSTGRES_DB: {{ project_name }}
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ project_name }}"]
      interval: 5s
      timeout: 5s
      retries: 10
  {% endif %}

  {% if config.use_celery %}
  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10

  celery:
    build:
      context: .
      args:
        REQUIREMENTS: requirements/development.txt
    command: celery -A {{ project_name }} worker -l info
    entrypoint: ["/bin/sh", "/app/entrypoint.sh"]
    user: "${UID:-1000}:${GID:-1000}"
    volumes:
      - .:/app
    depends_on:
      redis:
        condition: service_healthy
      {% if config.use_postgresql %}
      db:
        condition: service_healthy
      {% endif %}
    environment:
      - DEBUG=1
      - DJANGO_SETTINGS_MODULE={{ project_name }}.settings.development
      {% if config.use_postgresql %}
      - DB_NAME={{ project_name }}
      - DB_USER=postgres
      - DB_PASSWORD=postgres
      - DB_HOST=db
      - DB_PORT=5432
      {% endif %}
      - CELERY_BROKER_URL=redis://redis:6379/0
      - CELERY_RESULT_BACKEND=redis://redis:6379/0

  celery-beat:
    build:
      context: .
      args:
        REQUIREMENTS: requirements/development.txt
    command: celery -A {{ project_name }} beat -l info
    entrypoint: ["/bin/sh", "/app/entrypoint.sh"]
    user: "${UID:-1000}:${GID:-1000}"
    volumes:
      - .:/app
    depends_on:
      redis:
        condition: service_healthy
      {% if config.use_postgresql %}
      db:
        condition: service_healthy
      {% endif %}
    environment:
      - DEBUG=1
      - DJANGO_SETTINGS_MODULE={{ project_name }}.settings.development
      {% if config.use_postgresql %}
      - DB_NAME={{ project_name }}
      - DB_USER=postgres
      - DB_PASSWORD=postgres
      - DB_HOST=db
      - DB_PORT=5432
      {% endif %}
      - CELERY_BROKER_URL=redis://redis:6379/0
      - CELERY_RESULT_BACKEND=redis://redis:6379/0
  {% endif %}

volumes:
  {% if config.use_postgresql %}
  postgres_data:
  {% endif %}
  media_volume:
