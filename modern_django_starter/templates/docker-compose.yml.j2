services:
  web:
    build: .
    ports:
      - "8000:8000"
    volumes:
      - .:/app
      - media_volume:/app/media
    environment:
      - DEBUG=1
      - DJANGO_SETTINGS_MODULE={{ project_name }}.settings.development
    depends_on:
      {% if config.use_postgresql %}
      db:
        condition: service_healthy
      {% endif %}
      {% if config.use_celery %}
      redis:
        condition: service_started
      {% endif %}
    command: python manage.py runserver 0.0.0.0:8000

  {% if config.use_postgresql %}
  db:
    image: postgres:{{ config.postgresql_version }}
    volumes:
      - postgres_data:/var/lib/postgresql/data/
    environment:
      POSTGRES_DB: {{ project_name }}
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ project_name }}"]
      interval: 5s
      timeout: 5s
      retries: 10
  {% endif %}

  {% if config.use_celery %}
  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10

  celery:
    build: .
    command: celery -A {{ project_name }} worker -l info
    volumes:
      - .:/app
    depends_on:
      redis:
        condition: service_healthy
      {% if config.use_postgresql %}
      db:
        condition: service_healthy
      {% endif %}
    environment:
      - DEBUG=1
      - DJANGO_SETTINGS_MODULE={{ project_name }}.settings.development

  celery-beat:
    build: .
    command: celery -A {{ project_name }} beat -l info
    volumes:
      - .:/app
    depends_on:
      redis:
        condition: service_healthy
      {% if config.use_postgresql %}
      db:
        condition: service_healthy
      {% endif %}
    environment:
      - DEBUG=1
      - DJANGO_SETTINGS_MODULE={{ project_name }}.settings.development
  {% endif %}

volumes:
  {% if config.use_postgresql %}
  postgres_data:
  {% endif %}
  media_volume:
