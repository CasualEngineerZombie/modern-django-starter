#!/bin/sh
# Container entrypoint for {{ project_name }} (generated by modern-django-starter).
#
# The development stack (docker-compose.yml) runs this script before the
# application so that a fresh `docker compose up` is bootable as-is:
#  1. wait for required dependencies (database, Redis broker),
#  2. apply migrations,
#  3. collect static files,
#  4. hand off to the container command.
#
# Worker processes (`celery`) only wait for dependencies: the `web` service
# owns migrations/static setup so initialization happens exactly once per stack.
#
# Set SKIP_INIT=1 to bypass initialization entirely (one-off commands).
#
# Production differs: the plain Dockerfile image does NOT run this script -
# its default command is `gunicorn` and migrations are applied as a separate
# release step. See docs/deployment.md.
set -e

if [ "${SKIP_INIT:-0}" = "1" ]; then
    exec "$@"
fi

echo "[entrypoint] waiting for dependencies"

python - <<'PY'
import os
import time

import django

os.environ.setdefault(
    'DJANGO_SETTINGS_MODULE', '{{ project_name }}.settings.development'
)
django.setup()


def wait_until(ready, label, attempts=60, delay=2.0):
    """Poll ``ready()`` until it succeeds or the timeout expires."""
    for _ in range(attempts):
        try:
            if ready():
                return
        except Exception:
            pass
        time.sleep(delay)
    raise SystemExit(f'[entrypoint] {label} never became ready')


if os.environ.get('DB_HOST'):
    from django.db import connection

    def db_ready():
        connection.close()
        connection.ensure_connection()
        return True

    wait_until(db_ready, 'database')

broker_url = os.environ.get('CELERY_BROKER_URL', '')
if broker_url:
    try:
        import redis as redis_client
    except ImportError:
        raise SystemExit(
            '[entrypoint] CELERY_BROKER_URL is set but the redis package is not installed'
        )

    def broker_ready():
        redis_client.Redis.from_url(broker_url).ping()
        return True

    wait_until(broker_ready, 'redis broker')
PY

case "${1:-}" in
    celery)
        ;;
    *)
        echo "[entrypoint] applying migrations"
        python manage.py migrate --noinput
        echo "[entrypoint] collecting static files"
        python manage.py collectstatic --noinput
        ;;
esac

exec "$@"