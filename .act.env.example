# Environment overrides for local CI runs with act (see ci-local.sh).
#
# Copy to .act.env (gitignored) and adjust per machine if needed.
#
# ci-local.sh starts the compose kumo first and points the act job at it on
# localhost: act runs job containers on the host network, so localhost:4566
# reaches the compose-published S3 port. GitHub-hosted runners use the same
# default against the workflow's own kumo service container. Only override
# what differs from GitHub.
RUN_DJANGO_INTEGRATION_TESTS=1
AWS_S3_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_STORAGE_BUCKET_NAME=test-bucket
